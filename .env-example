# Only for local development. Never commit the real .env.
# These values stay in the Vite dev server (Node) and are never bundled:
# the dev proxy forwards /api to the instance and authenticates with the token.
CT_BASE_URL=https://<instanz>.church.tools
CT_LOGIN_TOKEN=

# Optional: build under a different extension key, e.g. infoscreen-designer-test
# VITE_KEY=infoscreen-designer
